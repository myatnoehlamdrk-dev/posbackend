APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# All dates this server renders and stores use Myanmar time (UTC+6:30).
APP_TIMEZONE=Asia/Yangon

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Reply/contact mailbox shown in the shop-owner notice. Empty falls back to
# MAIL_FROM_ADDRESS.
MAIL_CONTACT_ADDRESS=

# Set MAIL_MAILER=resend and a key to send over HTTPS. SMTP ports 25/465/587
# are blocked on Render's free tier, so smtp.gmail.com cannot be used there.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

IMGBB_API_KEY=
# Where uploaded images are kept:
#   imgbb -> ImgBB's CDN. Durable across deploys, works from every device.
#   local -> this server's disk (served through /uploads). Only safe when the
#            disk is persistent; an ephemeral host wipes it on every deploy.
# Unset defaults to imgbb when IMGBB_API_KEY is present, local otherwise.
IMAGES_STORE=imgbb

VITE_APP_NAME="${APP_NAME}"
